# API
NODE_ENV=development
API_PORT=3001
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nela

# Redis optional
REDIS_URL=

# Google OAuth - backend only
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/v1/auth/google/callback

# JWT/session
JWT_ACCESS_SECRET=dev-change-me-access-secret-min-32-chars
REFRESH_TOKEN_PEPPER=dev-change-me-refresh-pepper
# 32-byte key, base64 — encrypts ProviderKey rows (OpenRouter pool)
TOKEN_ENCRYPTION_KEY_BASE64=

# Razorpay - backend only (optional for OpenRouter Phase 1)
# Razorpay - backend only (put these in NELA-Webpage/.env, then restart the API)
# Test keys from https://dashboard.razorpay.com/app/keys — KEY_ID + KEY_SECRET
# are enough for Pay Now (creates a hosted payment link).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional: recurring plans. If unset, checkout uses one-time payment links.
RAZORPAY_PLAN_STARTER_ID=
RAZORPAY_PLAN_PRO_ID=

# OpenRouter - backend only (Render). Never put these on Vercel.
#
# Preferred (management-driven pool):
#   1. Create a Management API key at https://openrouter.ai/settings/management-keys
#   2. Set OPENROUTER_MANAGEMENT_KEY below
#   3. Leave OPENROUTER_API_KEY / FREE / PAID empty — the API mints encrypted
#      completion keys into the ProviderKey table on startup (ensurePool)
#   4. Set TOKEN_ENCRYPTION_KEY_BASE64 (32 bytes, base64) so keys are not stored as plain:
#        node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
OPENROUTER_MANAGEMENT_KEY=
# Legacy / bootstrap completion keys (optional). Prefer management key above.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_FREE=
OPENROUTER_API_KEY_PAID=
OPENROUTER_SITE_URL=https://nela.ai
OPENROUTER_APP_TITLE=NELA

# Phase-1 entitlement stub without Razorpay: free | starter | pro
CLOUD_ENTITLEMENT_OVERRIDE=

# Logging
LOG_LEVEL=info
PROMPT_LOGGING_ENABLED=false

# Swagger UI at http://localhost:3001/docs (on by default outside production).
# Spec is generated dynamically from Fastify route schemas — new endpoints appear automatically.
# SWAGGER_ENABLED=true

# Next.js (web)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=http://localhost:3000
